{
  "$comment": "Input to scripts/ui/gen-clicky.mjs. 'shared' is merged under both modes. Values are clicky-button ratios (percent of the button's own width or height), not pixel lengths; containerWidth/containerHeight only set the px fallback footprint (208 x 36, the rail key), because .btn-scale is resized live by container queries. Design family: flat rail keys over the scene, one accent (the latched face); wall and press depth are shallow ratios of the key height so the key reads as a low switch, not a tall block.",
  "toggleScope": ".cl-t",
  "clickScope": ".cl-c",
  "shared": {
    "containerWidth": 208,
    "containerHeight": 36,
    "btnCount": 1,
    "radiusRatio": 22,
    "faceColor": "#343c45",
    "textColor": "#f4f6f8",
    "fontWeight": "600",
    "letterSpacing": 0.02,
    "wallHRatio": 8,
    "pressDepthRatio": 9,
    "pressDarken": 14,
    "insetDepthRatio": 4,
    "insetBlurRatio": 5,
    "insetAlphaTop": 55,
    "insetAlphaBot": 30,
    "faceEdgeAlpha": 14,
    "highlightColor": "#ffffff",
    "highlightOpacity": 12,
    "rimHeightRatio": 3,
    "buttonWallShadowAlpha": 85,
    "buttonWallShadowEdgeRatio": 60,
    "cavityWallShadowAlpha": 90,
    "cavityWallShadowEdgeRatio": 60,
    "ambientIntensity": 14,
    "ambientBlurMult": 1.6,
    "ambientYMult": 1,
    "frameEnabled": true,
    "frameWidth": 2,
    "frameColorHi": "#66717c",
    "frameColor": "#3a434c",
    "frameColorLo": "#1c2127",
    "frameBevelAlpha": 16,
    "frameBevelWidth": 1,
    "frameBevelConic": false,
    "duration": 110,
    "pressDuration": 55,
    "easingPreset": "snappy",
    "hoverLift": 1,
    "focusStyle": "outline",
    "focusColor": "#e6f7ff",
    "focusSize": 2,
    "textWrap": false,
    "specularAlpha": 10,
    "specularSize": 45,
    "contactIntensity": 10
  },
  "toggle": {
    "mode": "toggle",
    "useToggleColor": true,
    "toggleColor": "#087282",
    "toggleHeightRatio": 70
  },
  "click": {
    "mode": "click",
    "faceColor": "#3f4952"
  }
}
