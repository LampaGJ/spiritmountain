{
  "$comment": "Input to scripts/ui/gen-clicky.mjs. 'shared' is merged under both modes. Values are clicky-button ratios (percent of the button's own width or height), not pixel lengths; containerWidth/containerHeight only set the px fallback footprint, because .btn-scale is resized live by container queries. Design family: a dark instrument console with one accent (the toggled face).",
  "toggleScope": ".cl-t",
  "clickScope": ".cl-c",
  "shared": {
    "containerWidth": 120,
    "containerHeight": 36,
    "btnCount": 1,
    "radiusRatio": 12,
    "faceColor": "#343c45",
    "textColor": "#f4f6f8",
    "fontWeight": "600",
    "letterSpacing": 0.02,
    "wallHRatio": 14,
    "pressDepthRatio": 17,
    "pressDarken": 14,
    "insetDepthRatio": 6,
    "insetBlurRatio": 6,
    "insetAlphaTop": 55,
    "insetAlphaBot": 30,
    "faceEdgeAlpha": 14,
    "highlightColor": "#ffffff",
    "highlightOpacity": 16,
    "rimHeightRatio": 5,
    "buttonWallShadowAlpha": 85,
    "buttonWallShadowEdgeRatio": 60,
    "cavityWallShadowAlpha": 90,
    "cavityWallShadowEdgeRatio": 60,
    "ambientIntensity": 30,
    "ambientBlurMult": 1.6,
    "ambientYMult": 1,
    "frameEnabled": true,
    "frameWidth": 3,
    "frameColorHi": "#66717c",
    "frameColor": "#3a434c",
    "frameColorLo": "#1c2127",
    "frameBevelAlpha": 22,
    "frameBevelWidth": 1,
    "frameBevelConic": false,
    "duration": 110,
    "pressDuration": 55,
    "easingPreset": "snappy",
    "hoverLift": 1,
    "focusStyle": "outline",
    "focusColor": "#e6f7ff",
    "focusSize": 2,
    "textWrap": false,
    "specularAlpha": 14,
    "specularSize": 45,
    "contactIntensity": 12
  },
  "toggle": {
    "mode": "toggle",
    "useToggleColor": true,
    "toggleColor": "#0b7e8d",
    "toggleHeightRatio": 70
  },
  "click": {
    "mode": "click",
    "faceColor": "#3f4952"
  }
}
